FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html .
COPY vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY tailwind.config.ts components.json eslint.config.js ./
COPY public/ ./public/
COPY frontend/ ./frontend/

EXPOSE 3000

CMD ["npm", "run", "dev"]
